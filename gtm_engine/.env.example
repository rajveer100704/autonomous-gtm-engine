# Copy to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# This file (.env.example) is safe to commit; it has only placeholders.

# ── Lead sourcing ─────────────────────────────────────────────────────────
# Apollo.io API key for prospect discovery
APOLLO_API_KEY=

# ── LLM (all reasoning agents) ───────────────────────────────────────────
# Google Gemini API key — research, pain points, email, linkedin, strategy, quality review
GEMINI_API_KEY=

# ── Web search for grounded research ─────────────────────────────────────
# Tavily API key — company research, news, hiring, website signals
TAVILY_API_KEY=
RESEARCH_CACHE_TTL_HOURS=168

# ── Email delivery ────────────────────────────────────────────────────────
# Gmail OAuth (recommended)
# 1. Download credentials.json from Google Cloud Console (OAuth 2.0 Desktop Client)
# 2. Set path here; first real run opens a browser for Google consent → saves token.json
GMAIL_CREDENTIALS_PATH=credentials.json

# SendGrid (alternative to Gmail for transactional/bulk email)
SENDGRID_API_KEY=

# ── LinkedIn browser automation ───────────────────────────────────────────
# Used by linkedin_executor.py (Playwright — NOT the official LinkedIn API)
# Session is saved to browser/linkedin_state.json after first login
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── Execution mode ────────────────────────────────────────────────────────
# true  = AI fills forms, human clicks Send (safer, recommended)
# false = fully autonomous (use with daily rate limits)
HUMAN_APPROVAL_MODE=true

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (no server needed): sqlite:///gtm.db
# Production Postgres: postgresql+psycopg2://user:password@host:5432/gtm
DATABASE_URL=sqlite:///gtm.db

# ── Campaign / sender identity ────────────────────────────────────────────
SENDER_NAME=Your Name
SENDER_COMPANY=SuperDocs
SENDER_PRODUCT_PITCH=SuperDocs helps teams generate, review and manage documents with AI.
FOLLOW_UP_DELAY_DAYS=3
MAX_FOLLOW_UPS=2

# ── Mock mode (set to false when real API keys above are filled in) ────────
# true  = no external calls, deterministic mock responses (good for demos/tests)
# false = real API calls (Apollo, Gemini, Tavily, Gmail/SendGrid, LinkedIn)
GTM_MOCK_MODE=true

# ── V3 Agent & Platform Controls ──────────────────────────────────────────
# Gating score for the Content Evaluation Agent (Stage 2 LLM Review, 0-10 scale)
EVAL_SCORE_THRESHOLD=7.0

# Senders booking link for the Calendar Agent to draft into booking replies
SENDER_CALENDAR_PLATFORM=calendly
SENDER_CALENDAR_URL=https://calendly.com/superdocs/demo

# ── Redis Queue Configuration ─────────────────────────────────────────────
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
WORKER_ID=default_worker

# ── Observability Configuration ──────────────────────────────────────────
USE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Files to add to .gitignore ────────────────────────────────────────────
# .env
# token.json
# credentials.json
# browser/linkedin_state.json
# gtm.db
# gtm_graph_state.db
